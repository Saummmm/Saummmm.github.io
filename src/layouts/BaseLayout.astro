---
import "../styles/global.css";
const { title = "Saumya Buch", description = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script>
      (() => {
        // open
        document.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof HTMLElement)) return;

          const opener = t.closest("[data-open-dialog]");
          if (opener) {
            const id = opener.getAttribute("data-open-dialog");
            const dlg = id ? document.getElementById(id) : null;
            if (!(dlg instanceof HTMLDialogElement)) return;

            dlg.showModal();
            document.body.classList.add("no-scroll");

            // close on backdrop click
            dlg.addEventListener(
              "click",
              (ev) => {
                const rect = dlg.getBoundingClientRect();
                const inDialog =
                  ev.clientX >= rect.left &&
                  ev.clientX <= rect.right &&
                  ev.clientY >= rect.top &&
                  ev.clientY <= rect.bottom;
                if (!inDialog) dlg.close();
              },
              { once: true }
            );
          }

          // close
          if (t.matches("[data-close-dialog]")) {
            const dlg = t.closest("dialog");
            if (dlg) dlg.close();
            document.body.classList.remove("no-scroll");
          }
        });
      })();
    </script></head
  >

  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/">Saumya Buch</a>
        <div class="links">
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main class="content">
      <slot />
    </main>

    <!-- <footer class="site-footer">
      <span>© {new Date().getFullYear()} Saumya Buch</span>
      <span class="sep">·</span>
      <a href="https://github.com/YOUR_GITHUB_USERNAME">GitHub</a>
      <span class="sep">·</span>
      <a href="https://www.linkedin.com/in/YOUR_LINKEDIN/">LinkedIn</a>
    </footer> -->
  </body>
</html>
